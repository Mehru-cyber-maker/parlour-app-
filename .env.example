# Optional. The app defaults to .data/bookwise.sqlite in the working directory.
# BOOKWISE_DB_PATH=/absolute/path/to/bookwise.sqlite
# Demo accounts are on by default only in development; explicitly enable for a local production demo.
BOOKWISE_DEMO_MODE=true
# Enable when serving behind HTTPS. Do not use true for a local HTTP demo.
BOOKWISE_SECURE_COOKIES=false
